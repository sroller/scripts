#!/usr/bin/env ruby

# Create a 24-hour movie from a timelapse directory
# Usage: create-24h-movie [options] <timelapse-directory>
#
# Processes timelapse pictures (tl000001.jpg to tl<maxnum>.jpg) and creates:
# - x264 video (HD 1920x1080, 3500k bitrate)
# - vp9 video (HD 1920x1080, 3500k bitrate)
# - x265/hevc video (HD 1920x1080, 3500k bitrate)
# - x265/hevc video (HD 1920x1080, default quality)
#
# Moves videos to ~/movies/<month>/{x264,webm,x265,hq}
# Deletes the exif-* directory after processing

require 'thor'
require 'fileutils'
require 'pathname'

class Create24hMovie < Thor
  desc "create <timelapse_dir>", "Creates movies from a timelapse directory"
  map %w[-i --interval] => :interval
  map %w[-r --rate] => :rate
  map %w[-v --verbose] => :verbose
  map %w[-t --target-dir] => :target_dir
  map %w[-h --help] => :help

  class_option :interval, type: :string,
                          default: ENV['INTERVAL'] || '120',
                          desc: 'Time interval between frames in seconds (default: 120)'
  class_option :rate, type: :string,
                      default: ENV['RATE'] || '30',
                      desc: 'Frame rate (default: 30, use 25 for PAL)'
  class_option :verbose, type: :boolean,
                         default: ENV['VERBOSE'] != '0',
                         desc: 'Enable verbose output'
  class_option :target_dir, type: :string,
                            default: '.',
                            desc: 'Working directory (default: current directory)'
  class_option :help, type: :boolean,
                     default: false,
                     desc: 'Show help for this command'

  def self.banner
    "create-24h-movie [options] <timelapse-directory>"
  end

  def create(timelapse_dir = nil)
    return print_help if options[:help] || timelapse_dir.nil?
    run_create_movie(timelapse_dir)
  end

  def self.exit_on_no_argument_error?
    false
  end

  no_commands do
    def print_help
      say <<-HELP
Usage: create-24h-movie [options] <timelapse-directory>

Creates a 24-hour movie from a timelapse directory.

  Processes timelapse pictures (tl000001.jpg to tl<maxnum>.jpg) and creates:
    - x264 video (HD 1920x1080, 3500k bitrate)
    - vp9 video (HD 1920x1080, 3500k bitrate)
    - x265/hevc video (HD 1920x1080, 3500k bitrate)
    - x265/hevc video (HD 1920x1080, default quality)

  Output is organized by month in ~/movies/<month>/{x264,webm,x265,hq}

Options:
    -i INTERVAL, --interval=INTERVAL
                              Time interval between frames in seconds (default: 120)
    -r RATE, --rate=RATE      Frame rate (default: 30, use 25 for PAL)
    -v, --verbose             Enable verbose output
    -t TARGET_DIR, --target-dir=TARGET_DIR
                              Working directory (default: current directory)
    -h, --help                Show this help message

Environment Variables:
    MOVIES                    Destination directory for movies (default: ~/movies)
    INTERVAL                  Time interval between frames (default: 120)
    RATE                      Frame rate (default: 30)
    VERBOSE                   Enable verbose output (set to non-zero)

Examples:
    create-24h-movie 20240101
    create-24h-movie 20240101 -v
    INTERVAL=60 create-24h-movie 20240101

See also: process-tl-dir
      HELP
    end
  end

  private

  def run_create_movie(timelapse_dir)
    interval = options[:interval]
    rate = options[:rate]
    verbose = options[:verbose]
    target_dir = options[:target_dir] || Dir.pwd
    movies_dir = expand_path(ENV['MOVIES'] || '~/movies')

    # Validate and change into target directory
    return exit_with_error("No directory specified") if timelapse_dir.nil? || timelapse_dir.empty?

    unless Dir.exist?(timelapse_dir)
      return exit_with_error("#{timelapse_dir} does not exist")
    end

    Dir.chdir(timelapse_dir) or return exit_with_error("Cannot change to directory")

    # Extract and display month from directory name
    month = extract_month_from_dirname
    say "Processing: #{Dir.pwd} (#{month})" if verbose

    # Process the timelapse directory
    unless process_timelapse(interval, verbose)
      return exit_with_error("#{Dir.pwd}: couldn't process pictures")
    end

    # Find the latest exif-* directory (within 10 minutes)
    exif_dir = find_latest_exif_dir
    return exit_with_error("No exif-* directory found") if exif_dir.nil? || exif_dir.empty?

    Dir.chdir(exif_dir) or return exit_with_error("Cannot change to exif directory")

    # Create output directories
    create_output_dirs(month, movies_dir)

    # Generate videos in order of speed (fastest to slowest)
    say "Generating x264 video..."
    generate_x264_video(movies_dir, rate)

    say "Generating vp9 video..."
    generate_vp9_video(movies_dir, rate)

    say "Generating x265/hevc video..."
    generate_hevc_video(movies_dir, rate)

    say "Generating x265/hevc HQ video..."
    generate_hevc_hq_video(movies_dir, rate)

    Dir.chdir('..') or return exit_with_error("Cannot exit exif directory")
    cleanup_exif_dir(exif_dir) if verbose

    say "Done! Videos saved to:"
    say "  #{movies_dir}/#{month}/x264/"
    say "  #{movies_dir}/#{month}/webm/"
    say "  #{movies_dir}/#{month}/x265/"
    say "  #{movies_dir}/#{month}/hq/"

    0
  rescue StandardError => e
    exit_with_error("Error: #{e.message}")
  end

  def exit_with_error(message)
    say(message, :color => :red)
    exit 1
  end

  def expand_path(path)
    Pathname.new(path).expand_path.to_s
  end

  def extract_month_from_dirname
    basename = File.basename(Dir.pwd)
    begin
      DateTime.parse(basename).strftime('%m-%B')
    rescue StandardError
      basename
    end
  end

  def process_timelapse(interval, verbose)
    verbose_string = verbose ? '1' : '0'
    command = "process-tl-dir -i #{interval} -v #{verbose_string}"
    say "Running: #{command}" if verbose
    system(command)
  end

  def find_latest_exif_dir
    Dir.glob('exif-*')
       .select { |d| File.directory?(d) && (Time.now - File.mtime(d)).to_i < 600 }
       .max_by { |d| File.mtime(d) }
  end

  def create_output_dirs(month, movies_dir)
    %w[x264 webm x265 hq].each do |codec|
      output_path = "#{movies_dir}/#{month}/#{codec}"
      FileUtils.mkdir_p(output_path)
      say "Created: #{output_path}" if $VERBOSE
    end
  end

  def generate_x264_video(movies_dir, rate)
    run_mkmov("-c x264 -w 1920 -b 3500k -r #{rate}")
    move_files('*.mp4', "#{movies_dir}/#{current_month}/x264")
  end

  def generate_vp9_video(movies_dir, rate)
    run_mkmov("-c vp9 -w 1920 -b 3500k -2 -r #{rate}")
    move_files('*.webm', "#{movies_dir}/#{current_month}/webm")
  end

  def generate_hevc_video(movies_dir, rate)
    run_mkmov("-c hevc -w 1920 -b 3500k -2 -r #{rate}")
    move_files('*.mp4', "#{movies_dir}/#{current_month}/x265")
  end

  def generate_hevc_hq_video(movies_dir, rate)
    run_mkmov("-c hevc -w 1920 -r #{rate}")
    move_files('*.mp4', "#{movies_dir}/#{current_month}/hq")
  end

  def run_mkmov(args)
    system("mkmov #{args}")
  end

  def move_files(glob_pattern, dest_dir)
    files = Dir[glob_pattern]
    if files.any?
      FileUtils.mv(files, dest_dir)
    end
  end

  def cleanup_exif_dir(exif_dir)
    say("Removing #{exif_dir}")
    FileUtils.rm_rf(exif_dir)
  end

  def current_month
    File.basename(Dir.pwd)
  end
end

Create24hMovie.start(ARGV)
