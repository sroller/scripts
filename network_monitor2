#!/bin/bash

TEKSAVVY=mysavvy.teksavvy.com
LOG_DIR=/var/log/network_monitor
LOG_FILE=$LOG_DIR/network_monitor2.log
OUTAGE_TRACKER=$LOG_DIR/outages_$(date +%Y%m%d).tracker

# Ensure log directory exists with proper permissions
mkdir -p "$LOG_DIR"
touch "$LOG_FILE"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" | tee -a "$LOG_FILE"
}

alert_all_terminals() {
    local duration=$1
    local message="$1"
    # Broadcast to all logged-in users' terminals
    echo "NETWORK OUTAGE ALERT: Connection to $TEKSAVVY has been down for ${duration} seconds!" | wall
}

log "Network monitor started"

while true
do
    if ping -c 1 -W 1 "$TEKSAVVY" &> /dev/null; then
        echo -en "$(date +%H:%M:%S)\r"
    else
        # Capture outage start time
        START_TIME=$(date +%s)

        # Router check (secondary diagnostic)
        curl --head -s --max-time 2 http://192.168.1.1/webpages/login.html > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            log "$(date +%Y%m%d-%H%M%S): curl to router NOT ok"
        fi

        # Continuous retry loop
        while true; do
            if ping -c 1 -W 1 "$TEKSAVVY" &> /dev/null; then
                END_TIME=$(date +%s)
                OUTAGE_DURATION=$((END_TIME - START_TIME))

                if [ $OUTAGE_DURATION -gt 5 ]; then
                    log "$(date '+%Y-%m-%d %H:%M:%S'),${OUTAGE_DURATION} Connection restored after ${OUTAGE_DURATION} seconds"
                    echo "$OUTAGE_DURATION" >> "$OUTAGE_TRACKER"
                fi

                # Alert if outage exceeded 60 seconds
                if [ $OUTAGE_DURATION -gt 60 ]; then
                    alert_all_terminals "$OUTAGE_DURATION"
                fi

                break
            fi

            # Alert if outage exceeds 60 seconds
            CURRENT_TIME=$(date +%s)
            CURRENT_DURATION=$((CURRENT_TIME - START_TIME))
            if [ $CURRENT_DURATION -gt 60 ]; then
                alert_all_terminals "$CURRENT_DURATION"
            fi

            echo -n "X"
            sleep 1
        done
    fi
    sleep 1
done
